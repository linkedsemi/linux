if ARCH_LINKEDSEMI || COMPILE_TEST

menu "Linkedsemi SoC drivers"

config MCTP_PCIE_LINKEDSEMI
	tristate "MCTP over PCIe VDM transport for Linkedsemi LS2010"
	depends on PCIE_DW_LINKEDSEMI
	help
	  MCTP transport over PCIe vendor-defined messages for the
	  Linkedsemi LS2010 endpoint controller. It exposes a character
	  device compatible with the Aspeed MCTP interface.

	  This support is also available as a module. The module will be
	  called linkedsemi-pcie-mctp.

config ESPI_VW_LINKEDSEMI
	tristate "Linkedsemi LS2010 eSPI virtual wire driver"
	depends on OF && MAILBOX
	help
	  eSPI virtual wire (VW) channel driver for the Linkedsemi LS2010
	  SoC. It exchanges VW messages with the E906 firmware over a
	  mailbox channel and reads the system-event mirror from the shared
	  SRAM window. It exposes the AST2700 aspeed-espi-vw compatible
	  /dev/linkedsemi-espi-vwN ioctl interface plus a
	  /dev/linkedsemi-espi-pltrstnN PLTRST# monitor.

	  This support is also available as a module. The module will be
	  called linkedsemi-espi-vw.

endmenu

endif
